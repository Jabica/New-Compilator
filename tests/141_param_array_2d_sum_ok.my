funcao soma2(m: inteiro[2][3]): inteiro {
  variavel s: inteiro = 0;
  variavel i: inteiro = 0;
  enquanto (i < 2) {
    variavel j: inteiro = 0;
    enquanto (j < 3) {
      s = s + m[i][j];
      j = j + 1;
    }
    i = i + 1;
  }
  retorna s;
}

funcao main(): inteiro {
  variavel a: inteiro[2][3];
  a[0][0]=1; a[0][1]=2; a[0][2]=3;
  a[1][0]=4; a[1][1]=5; a[1][2]=6; // soma = 21
  retorna soma2(a);
}

