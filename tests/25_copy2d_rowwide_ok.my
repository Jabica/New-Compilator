funcao main(): inteiro {
  variavel a: inteiro[12];
  variavel b: inteiro[12];

  b[0]=1; b[1]=2; b[2]=3; b[3]=4;
  b[4]=5; b[5]=6; b[6]=7; b[7]=8;
  b[8]=9; b[9]=10; b[10]=11; b[11]=12;

  fill2d(a, 4, 0, 0, 4, 3);
  copy2d(a, 4, 0, b, 4, 4, 4, 2);

  variavel s: inteiro;
  s = a[0]+a[1]+a[2]+a[3] + a[4]+a[5]+a[6]+a[7];
  retorna s; // 68
}

