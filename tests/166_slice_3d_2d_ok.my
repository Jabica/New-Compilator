funcao soma2d(m: inteiro[3][4]): inteiro {
  variavel s: inteiro;
  s = 0;
  variavel i: inteiro; variavel j: inteiro;
  i = 0;
  enquanto (i < 3) {
    j = 0;
    enquanto (j < 4) {
      s = s + m[i][j];
      j = j + 1;
    }
    i = i + 1;
  }
  retorna s;
}

funcao main(): inteiro {
  variavel a: inteiro[2][3][4];
  // Preenche a[1] com 1..12 (soma=78)
  variavel v: inteiro; v = 1;
  variavel i: inteiro; variavel j: inteiro;
  i = 0;
  enquanto (i < 3) {
    j = 0;
    enquanto (j < 4) {
      a[1][i][j] = v;
      v = v + 1;
      j = j + 1;
    }
    i = i + 1;
  }
  retorna soma2d(a[1]);
}

