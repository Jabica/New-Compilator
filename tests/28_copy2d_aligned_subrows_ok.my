funcao main(): inteiro {
  variavel a: inteiro[15];
  variavel b: inteiro[15];
  variavel i: inteiro;
  i = 0;
  enquanto (i < 15) { b[i] = i + 1; i = i + 1; }
  // stride=5, cols=5, srcIdx=5 (alinhado), rows=2 => bloco contiguo (10 elementos)
  copy2d(a, 5, 0, b, 5, 5, 5, 2);
  variavel s: inteiro; s = 0; i = 0;
  enquanto (i < 10) { s = s + a[i]; i = i + 1; }
  retorna s; // 105
}

