funcao main(): inteiro {
  variavel a: inteiro[12];
  variavel b: inteiro[12];
  // inicializa b com 10..21
  b[0]=10; b[1]=11; b[2]=12; b[3]=13;
  b[4]=14; b[5]=15; b[6]=16; b[7]=17;
  b[8]=18; b[9]=19; b[10]=20; b[11]=21;

  // zera a (3x4)
  fill2d(a, 4, 0, 0, 4, 3);

  // copia submatriz 2x3 de b[1] para a[0]
  copy2d(a, 4, 0, b, 4, 1, 3, 2);

  variavel s: inteiro;
  s = a[0] + a[1] + a[2] + a[4] + a[5] + a[6];
  retorna s; // 84
}

